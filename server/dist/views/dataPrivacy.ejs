<!DOCTYPE html>
<html lang="en">
<!-- hamlive-oss — MIT License. See LICENSE. -->

<head>
  <%- include('./partials/head') %>
  <%- include('./partials/pageTopFeatures') %>
  <title><%= server.appName %> - Data Privacy <% if (server.logLevel !== "info") { %> (<%= server.logLevel %>) <% } %></title>
</head>

<body class="app-page privacy-page">
  <%- include('./partials/navbar', { user: user }) %>

  <main class="app-main privacy-main">
    <header class="settings-hero">
      <div class="container">
        <div class="landing-kicker">Privacy &amp; Preferences</div>
        <h1 class="workspace-title">Data Privacy</h1>
        <p class="workspace-copy">Manage your communication, privacy, and account preferences.</p>
        <img class="settings-header-tower" src="/img/NCO_Logger_Logo_Tower_Only.png" alt="" aria-hidden="true" />
      </div>
    </header>

    <div class="container privacy-workspace">
      <form id="dataprivacy_form" class="privacy-preferences-card">
        <div class="section-eyebrow">Preferences</div>
        <h2>Communication Preferences</h2>

        <div class="privacy-setting-row">
          <div>
            <label for="flexOpt-email">Email Notifications</label>
            <p>Receive email notifications for nets you follow and net reports when applicable.</p>
          </div>
          <input class="flexOption privacy-toggle" type="checkbox" role="switch" id="flexOpt-email" />
        </div>

        <div class="privacy-setting-row">
          <div>
            <label for="flexOpt-chat">Live Net Chat</label>
            <p>Show the interactive chat feature while participating in live nets.</p>
          </div>
          <input class="flexOption privacy-toggle" type="checkbox" role="switch" id="flexOpt-chat" />
        </div>
      </form>

      <section class="privacy-danger-card" aria-labelledby="delete-account-heading">
        <div class="section-eyebrow">Account</div>
        <h2 id="delete-account-heading">Delete Account</h2>
        <p>Permanently remove your NCO Logger account and associated account data.</p>
        <button type="button" id="delete_my_account_btn" class="privacy-danger-button" data-bs-toggle="modal" data-bs-target="#account_delete_modal">
          <i class="bi bi-person-x" aria-hidden="true"></i>
          Delete My Account
        </button>
      </section>
    </div>
  </main>

  <div class="modal fade app-modal" id="account_delete_modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="account_delete_modal_title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <div class="section-eyebrow">Account</div>
            <h2 class="modal-title h5" id="account_delete_modal_title">Delete Account</h2>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div id="delete_confirmation">
            <p>Your account will be marked for deletion. Owned net data may be affected when deletion is processed.</p>
            <p>This action can be undone before account deletion is processed.</p>
          </div>
          <div id="delete_output" role="status" aria-live="polite" hidden></div>
        </div>
        <div class="modal-footer">
          <button type="button" id="cancel_delete_account_btn" class="app-button app-button-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="confirm_delete_my_account_btn" class="privacy-danger-button">Delete My Account</button>
          <button type="button" id="undelete_my_account_btn" class="app-button app-button-primary" hidden>
            <i class="bi bi-person-plus-fill" aria-hidden="true"></i>
            Undelete
          </button>
        </div>
      </div>
    </div>
  </div>

  <%- include('./partials/footer') %>
  <%- include('./partials/pageBottomFeatures') %>
  <script src="/js/byView/<%= VIEW %>/main.js?v=<%= server.appAssetVersion %>" type="module"></script>
</body>

</html>
