<!DOCTYPE html>
<html lang="en">
<!-- hamlive-oss — MIT License. See LICENSE. -->

<head>
  <%- include('./partials/head') %>
  <%- include('./partials/pageTopFeatures') %>
  <title><%= server.appName %> - Favorite Nets <% if (server.logLevel !== "info") { %> (<%= server.logLevel %>) <% } %></title>
</head>

<body class="app-page favorites-page">
  <%- include('./partials/navbar', { user: user }) %>

  <main class="app-main favorites-main">
    <header class="favorites-hero">
      <div class="container">
        <div class="landing-kicker">Favorites</div>
        <h1 class="workspace-title">Favorite Nets</h1>
        <p class="workspace-copy">Keep your favorite nets in one place and quickly see when they're on the air.</p>
        <img class="favorites-header-tower" src="/img/NCO_Logger_Logo_Tower_Only.png" alt="" aria-hidden="true" />
      </div>
    </header>

    <div class="container favorites-workspace">
      <hl-favlist></hl-favlist>
    </div>
  </main>

  <%- include('./partials/footer') %>
  <%- include('./partials/pageBottomFeatures') %>
  <script src="/js/byView/<%= VIEW %>/main.js?v=<%= server.appAssetVersion %>" type="module"></script>
</body>

</html>
