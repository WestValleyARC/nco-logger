<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('./partials/head') %>
  <%- include('./partials/pageTopFeatures') %>
  <title><%= server.appName %> - Contact<% if (server.logLevel !== "info") { %> (<%= server.logLevel %>)<% } %></title>
</head>

<body class="app-page contact-page">
  <%- include('./partials/navbar', { user: user }) %>

  <main class="app-main contact-main">
    <div class="container contact-layout">
      <header class="contact-heading">
        <div class="landing-kicker">Contact</div>
        <h1>Contact NCO Logger</h1>
        <p>Questions, feedback, or need help with NCO Logger? Send us a message.</p>
      </header>

      <section class="contact-card" aria-labelledby="contact-form-heading">
        <div class="section-eyebrow">Message the Team</div>
        <h2 id="contact-form-heading">Send a Message</h2>

        <% if (sent) { %>
        <div class="contact-notice contact-notice-success" role="status">
          <strong>Message sent</strong>
          <span>Your message has been sent to the NCO Logger team.</span>
        </div>
        <% } %>
        <% if (typeof deliveryError !== 'undefined' && deliveryError) { %>
        <div class="contact-notice contact-notice-error" role="alert"><%= deliveryError %></div>
        <% } %>

        <form method="post" action="/views/contact" class="contact-form">
          <div class="contact-form-grid">
            <div>
              <label class="app-label" for="contact-name">Name</label>
              <input class="form-control app-input" id="contact-name" name="name" type="text" maxlength="100" autocomplete="name" value="<%= form.name %>" required />
              <% if (errors.name) { %><p class="contact-field-error"><%= errors.name %></p><% } %>
            </div>
            <div>
              <label class="app-label" for="contact-callsign">Callsign <span>(optional)</span></label>
              <input class="form-control app-input" id="contact-callsign" name="callSign" type="text" maxlength="20" autocomplete="off" value="<%= form.callSign %>" />
              <% if (errors.callSign) { %><p class="contact-field-error"><%= errors.callSign %></p><% } %>
            </div>
          </div>

          <div>
            <label class="app-label" for="contact-email">Email</label>
            <input class="form-control app-input" id="contact-email" name="email" type="email" maxlength="254" autocomplete="email" value="<%= form.email %>" required />
            <% if (errors.email) { %><p class="contact-field-error"><%= errors.email %></p><% } %>
          </div>

          <div>
            <label class="app-label" for="contact-subject">Subject</label>
            <input class="form-control app-input" id="contact-subject" name="subject" type="text" maxlength="150" value="<%= form.subject %>" required />
            <% if (errors.subject) { %><p class="contact-field-error"><%= errors.subject %></p><% } %>
          </div>

          <div>
            <label class="app-label" for="contact-message">Message</label>
            <textarea class="form-control app-input" id="contact-message" name="message" maxlength="5000" rows="7" required><%= form.message %></textarea>
            <% if (errors.message) { %><p class="contact-field-error"><%= errors.message %></p><% } %>
          </div>

          <div class="contact-honeypot" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <button class="app-button app-button-primary contact-submit" type="submit">
            <i class="bi bi-send" aria-hidden="true"></i>
            Send Message
          </button>
        </form>
      </section>
    </div>
  </main>

  <%- include('./partials/footer') %>
  <%- include('./partials/pageBottomFeatures') %>
</body>

</html>
