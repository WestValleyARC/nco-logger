<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('./partials/head') %>
  <%- include('./partials/pageTopFeatures') %>
  <title><%= server.appName %> - Contact<% if (server.logLevel !== "info") { %> (<%= server.logLevel %>)<% } %></title>
</head>

<body class="app-page contact-page">
  <%- include('./partials/navbar', { user: user }) %>

  <main class="app-main contact-main">
    <div class="container contact-layout">
      <header class="contact-heading">
        <div class="landing-kicker">Contact</div>
        <h1>Contact NCO Logger</h1>
        <p>Questions, feedback, or need help with NCO Logger? Email the support team.</p>
      </header>

      <section class="contact-card" aria-labelledby="contact-support-heading">
        <div class="section-eyebrow">Support</div>
        <h2 id="contact-support-heading">Email Support</h2>
        <% if (supportEmail) { %>
        <p class="contact-support-link">
          <i class="bi bi-envelope" aria-hidden="true"></i>
          <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a>
        </p>
        <% } else { %>
        <p class="contact-support-link">Support contact information is not available right now.</p>
        <% } %>
      </section>
    </div>
  </main>

  <%- include('./partials/footer') %>
  <%- include('./partials/pageBottomFeatures') %>
</body>

</html>
