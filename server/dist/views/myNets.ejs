<!DOCTYPE html>
<html lang="en">
<!-- hamlive-oss — MIT License. See LICENSE. -->

<head>
  <%- include('./partials/head') %>
  <%- include('./partials/pageTopFeatures') %>
  <!-- prettier-ignore -->
  <%- include('./partials/featureTinyMceJs') %>
  <title><%= server.appName %> - My Nets <% if (server.logLevel !== "info") { %> (<%= server.logLevel %>) <% } %></title>
</head>

<body class="app-page net-manager-page">
  <%- include('./partials/navbar', { user: user }) %>

  <main class="app-main net-manager-main">
    <header class="net-manager-hero">
      <div class="container">
        <div class="row align-items-end g-4">
          <div class="col-lg-8">
            <div class="landing-kicker">Net management</div>
            <h1 class="workspace-title">Your nets</h1>
            <p class="workspace-copy">
              Create reusable net profiles, update operating details, assign co-owners, and take a net live.
            </p>
          </div>
        </div>
        <img class="net-manager-header-tower" src="/img/NCO_Logger_Logo_Tower_Only.png" alt="" aria-hidden="true" />
      </div>
    </header>

    <div class="container net-manager-workspace">
      <div class="net-manager-grid">
        <aside id="netListColumn" class="app-panel owned-nets-panel" aria-labelledby="owned-nets-heading">
          <div class="panel-heading">
            <div>
              <div class="section-eyebrow">Your stations</div>
              <h2 id="owned-nets-heading">Owned Nets</h2>
            </div>
            <span class="panel-count" id="net-count" aria-label="Net count">0</span>
          </div>
          <p class="panel-help">Start a net or choose a profile to edit its operating details.</p>
          <div id="netListContainer" aria-live="polite" aria-busy="true">
            <div class="panel-loading">
              <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
              Loading net profiles…
            </div>
          </div>
        </aside>

        <section id="formContainerNetProfile" class="app-panel net-editor-panel" aria-labelledby="net-profile-editor">
          <div class="panel-heading">
            <div>
              <div class="section-eyebrow">Profile details</div>
              <h2 id="net-profile-editor">Create or Edit a Net</h2>
            </div>
            <span class="form-status" id="netprofile_form_status" role="status" aria-live="polite"></span>
          </div>

          <form id="netprofile_form" class="app-form">
            <div class="app-field">
              <label for="input_title">Net name</label>
              <input placeholder="Example: WVARC Weekly Net" type="text" class="form-control app-input" id="input_title" name="title" maxlength="100" minlength="4" required />
              <small>4–100 characters. Letters, numbers, spaces, and common symbols are supported.</small>
            </div>

            <fieldset class="app-options-fieldset connections-fieldset">
              <div class="connections-heading">
                <div>
                  <legend>Connections</legend>
                  <small>Add every frequency, node, reflector, or other method operators can use.</small>
                </div>
                <button type="button" class="app-button app-button-secondary app-button-compact" id="add_connection">
                  <i class="bi bi-plus-lg" aria-hidden="true"></i>
                  Add Connection
                </button>
              </div>
              <div id="legacy_connection_notice" class="legacy-connection-notice" hidden></div>
              <div id="connections_container" class="connections-list" aria-live="polite"></div>
            </fieldset>

            <fieldset class="app-options-fieldset">
              <legend>Check-in behavior</legend>
              <div class="app-option-grid">
                <label class="app-option-card" for="input_auto_in">
                  <input class="form-check-input" type="checkbox" id="input_auto_in" name="auto_in" />
                  <span>
                    <strong>Automatically Check In Lurkers</strong>
                    <small>Lurkers are checked in automatically when they arrive.</small>
                  </span>
                </label>
              </div>
            </fieldset>

            <div class="app-field">
              <label for="input_notes">Welcome notes</label>
              <small>Keep this to roughly five lines. Attendees see it briefly when the live net opens.</small>
              <textarea class="form-control" name="notes" id="input_notes"></textarea>
            </div>

            <input type="hidden" name="input_netprofile_mode" id="input_netprofile_mode" />
            <input type="hidden" name="npid_for_netprofile" id="input_npid_for_netprofile" />

            <div class="app-form-actions">
              <button type="reset" class="app-button app-button-secondary" onclick='setNetProfileMode("new")'>
                Clear / new profile
              </button>
              <button type="submit" class="app-button app-button-primary">
                <i class="bi bi-check-lg" aria-hidden="true"></i>
                Save profile
              </button>
            </div>
          </form>
        </section>

        <section id="formContainerNetOwner" class="app-panel net-editor-panel d-none" aria-labelledby="netowner_form_title">
          <div class="panel-heading">
            <div>
              <div class="section-eyebrow">Shared management</div>
              <h2 id="netowner_form_title">Additional net owner</h2>
            </div>
            <span class="form-status" id="netowner_form_status" role="status" aria-live="polite"></span>
          </div>
          <p class="panel-help">The added operator must already have an account using this email address.</p>

          <form id="netowner_form" class="app-form">
            <div class="app-field">
              <label for="input_email">Co-owner email address</label>
              <input type="email" placeholder="operator@example.com" class="form-control app-input" id="input_email" name="email" autocomplete="email" required />
            </div>
            <input type="hidden" name="input_netowner_mode" id="input_netowner_mode" />
            <input type="hidden" name="npid_for_netowner" id="input_npid_for_netowner" />

            <div class="app-form-actions">
              <button type="reset" class="app-button app-button-secondary" onclick="formShow('formContainerNetProfile')">
                Cancel
              </button>
              <button type="submit" class="app-button app-button-primary">
                <i class="bi bi-person-plus" aria-hidden="true"></i>
                Add co-owner
              </button>
            </div>
          </form>
        </section>
      </div>
    </div>
  </main>

  <!-- Start-net modal template. A copy is created for each owned net. -->
  <div id="modal-collection">
    <div class="modal fade app-modal" id="modal-template" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <div>
              <div class="section-eyebrow">On the air</div>
              <h2 class="modal-title h5" id="modalNetStart">Start net</h2>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form id="netstart_form">
            <div class="modal-body">
              <div class="app-field">
                <label for="input_countdown-timer">Countdown minutes</label>
                <input id="input_countdown-timer" type="number" min="0" max="120" value="0" class="form-control app-input" placeholder="Minutes until the net is live" name="countdown-timer" required />
                <small id="netstart_form_output">
                  Followers will be notified when you start the net. The countdown gives them time to join before it goes live. Choose 0–120 minutes.
                </small>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="app-button app-button-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="app-button app-button-primary">
                <i class="bi bi-broadcast" aria-hidden="true"></i>
                Start net
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade app-modal" id="schedule-editor-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="schedule-editor-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered schedule-editor-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <div class="section-eyebrow">Net schedule</div>
            <h2 class="modal-title h5" id="schedule-editor-title">Manage Schedule</h2>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="schedule_editor_form" class="schedule-editor-form">
          <fieldset id="schedule_editor_fields">
            <div class="modal-body schedule-editor-body">
              <p id="schedule_editor_status" class="schedule-editor-status" role="status" aria-live="polite"></p>
              <input type="hidden" id="schedule_profile_id" />

              <div class="app-form-grid schedule-primary-fields">
                <div class="app-field">
                  <label for="schedule_type">Recurrence</label>
                  <select id="schedule_type" class="form-select app-input app-select" required>
                    <option value="oneTime">One Time</option>
                    <option value="weekly">Weekly / Multiple Weekdays</option>
                    <option value="monthlyPosition">Monthly by Position</option>
                    <option value="monthlyDate">Monthly by Date</option>
                  </select>
                </div>
                <div class="app-field">
                  <label for="schedule_timezone">Timezone</label>
                  <input id="schedule_timezone" class="form-control app-input" type="text" list="schedule_timezones" autocomplete="off" required />
                  <datalist id="schedule_timezones"></datalist>
                </div>
                <div class="app-field">
                  <label for="schedule_start_date">Start Date</label>
                  <input id="schedule_start_date" class="form-control app-input" type="date" required />
                </div>
                <div class="app-field">
                  <label for="schedule_start_time">Start Time</label>
                  <input id="schedule_start_time" class="form-control app-input" type="time" required />
                </div>
                <div class="app-field schedule-end-date-field" data-recurring-field>
                  <label for="schedule_end_date">End Date <span>(optional)</span></label>
                  <input id="schedule_end_date" class="form-control app-input" type="date" />
                  <small>Leave blank to repeat indefinitely.</small>
                </div>
              </div>

              <fieldset class="schedule-recurrence-fields" data-schedule-fields="weekly" hidden>
                <legend>Repeat On</legend>
                <div class="schedule-weekdays">
                  <% ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'].forEach((day, index) => { %>
                    <label><input type="checkbox" name="schedule_weekday" value="<%= index + 1 %>" /> <span><%= day.slice(0, 3) %></span></label>
                  <% }) %>
                </div>
                <small>Select one or more weekdays.</small>
              </fieldset>

              <div class="app-form-grid schedule-recurrence-fields" data-schedule-fields="monthlyPosition" hidden>
                <div class="app-field">
                  <label for="schedule_monthly_ordinal">Position</label>
                  <select id="schedule_monthly_ordinal" class="form-select app-input app-select">
                    <option value="1">First</option>
                    <option value="2">Second</option>
                    <option value="3">Third</option>
                    <option value="4">Fourth</option>
                    <option value="5">Fifth</option>
                    <option value="-1">Last</option>
                  </select>
                </div>
                <div class="app-field">
                  <label for="schedule_monthly_weekday">Weekday</label>
                  <select id="schedule_monthly_weekday" class="form-select app-input app-select">
                    <% ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'].forEach((day, index) => { %>
                      <option value="<%= index + 1 %>"><%= day %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <div class="schedule-recurrence-fields" data-schedule-fields="monthlyDate" hidden>
                <div class="app-field">
                  <label for="schedule_monthly_day">Day of Month</label>
                  <input id="schedule_monthly_day" class="form-control app-input" type="number" min="1" max="31" value="1" />
                  <small>For shorter months, only valid calendar dates produce occurrences.</small>
                </div>
              </div>

              <section id="schedule_occurrences" class="schedule-occurrences" aria-labelledby="schedule-occurrences-title">
                <div class="schedule-occurrences-heading">
                  <div>
                    <h3 id="schedule-occurrences-title">Upcoming Occurrences</h3>
                    <p>Reschedule or cancel one occurrence without changing the recurring schedule.</p>
                  </div>
                  <span id="schedule_occurrences_status" role="status" aria-live="polite"></span>
                </div>
                <div id="schedule_occurrences_list" class="schedule-occurrences-list" aria-live="polite"></div>
              </section>
            </div>

            <div class="modal-footer schedule-editor-actions">
              <button type="button" id="schedule_disable" class="app-button app-button-danger" hidden>Disable Schedule</button>
              <span class="schedule-action-spacer"></span>
              <button type="button" class="app-button app-button-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="app-button app-button-primary">Save Schedule</button>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>

  <%- include('./partials/pageBottomFeatures') %>
  <script src="/js/byView/<%= VIEW %>/main.js" type="module"></script>
  <%- include('./partials/footer') %>
</body>

</html>
