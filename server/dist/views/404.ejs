<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('./partials/head') %>
  <%- include('./partials/pageTopFeatures') %>
  <title>NCO Logger - Page Not Found <% if (server.logLevel !== "info") { %> (<%= server.logLevel %>) <% } %></title>
</head>

<body class="app-page">
  <%- include('./partials/navbar', { user: user }) %>

  <main class="app-main d-flex align-items-center py-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
          <section class="app-panel p-4 p-md-5 text-center" aria-labelledby="not-found-heading">
            <div class="section-eyebrow">404</div>
            <h1 class="section-title" id="not-found-heading">Page Not Found</h1>
            <p class="workspace-copy mx-auto mt-3">The page you're looking for could not be found.</p>
            <a class="app-button app-button-primary mt-4" href="/">Back to NCO Logger</a>
          </section>
        </div>
      </div>
    </div>
  </main>

  <%- include('./partials/footer') %>
  <%- include('./partials/pageBottomFeatures') %>
</body>

</html>
