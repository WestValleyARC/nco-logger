<!DOCTYPE html>
<html lang="en">
<!-- hamlive-oss — MIT License. See LICENSE. -->

<head>
  <%- include('./partials/head') %>
  <%- include('./partials/pageTopFeatures') %>
  <title><%= server.appName %> <% if (server.logLevel !== "info") { %> (<%= server.logLevel %>) <% } %></title>
</head>

<body class="app-page landing-page">
  <%- include('./partials/navbar', { user: user, landing: true }) %>

  <main class="app-main">
    <section class="landing-hero" aria-labelledby="landing-title">
      <div class="container">
        <div class="landing-hero-copy">
            <h1 class="landing-title" id="landing-title">
              <span class="landing-title-phrase landing-title-run">Run a net.</span>
              <span class="landing-title-phrase landing-title-find">Find a net.</span>
              <span class="landing-title-phrase landing-title-join">Join in.</span>
            </h1>
            <p class="landing-copy">
              A modern home for amateur radio nets — schedule, discover, follow, check in, and participate from anywhere.
            </p>
            <div class="landing-actions">
              <a class="app-button app-button-primary" href="<%= user.isLoggedIn ? '/views/mynets' : '/views/login' %>">
                <i class="bi bi-play-fill" aria-hidden="true"></i>
                START A NET
              </a>
              <a class="app-button app-button-secondary" href="#net-schedule">
                <i class="bi bi-calendar3" aria-hidden="true"></i>
                VIEW SCHEDULE
              </a>
            </div>
        </div>
      </div>
    </section>

    <section class="landing-features" aria-label="NCO Logger features">
      <div class="container">
        <div class="landing-feature-grid">
          <article class="landing-feature-card">
            <span class="landing-feature-icon"><i class="bi bi-bullseye" aria-hidden="true"></i></span>
            <div>
              <h2>Accurate Logging</h2>
              <p>Real-time check-ins and participant tracking.</p>
            </div>
          </article>
          <article class="landing-feature-card">
            <span class="landing-feature-icon"><i class="bi bi-sliders" aria-hidden="true"></i></span>
            <div>
              <h2>Net Control Tools</h2>
              <p>Everything NCOs need to run a smooth, organized net.</p>
            </div>
          </article>
          <article class="landing-feature-card">
            <span class="landing-feature-icon"><i class="bi bi-chat-dots" aria-hidden="true"></i></span>
            <div>
              <h2>Chat &amp; Community</h2>
              <p>Communicate with other participants during a live net.</p>
            </div>
          </article>
          <article class="landing-feature-card">
            <span class="landing-feature-icon landing-feature-icon-no-cost"><i class="bi bi-currency-dollar" aria-hidden="true"></i></span>
            <div>
              <h2>Free to Use</h2>
              <p>Available to the amateur radio community at no cost.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="landing-net-board" id="net-schedule" aria-labelledby="net-schedule-title">
      <div class="container">
        <h2 class="visually-hidden" id="net-schedule-title">Net schedule</h2>

        <div class="landing-net-grid">
          <section class="landing-net-panel landing-live-panel" id="live-nets" aria-labelledby="live-nets-title">
            <header class="landing-net-panel-heading">
              <span class="landing-live-dot" aria-hidden="true"></span>
              <h3 id="live-nets-title">Live Nets</h3>
            </header>

            <div class="nets-list" id="dashItemsContainer" aria-live="polite" aria-busy="true">
              <div class="nets-state" id="nets-state">
                <i class="bi bi-broadcast-pin" aria-hidden="true"></i>
                Checking for live nets…
              </div>

              <!-- Template for dynamically generated net rows. IDs are scoped to each cloned row. -->
              <div id="netTemplate" class="net-card d-none">
                <div class="net-card-main">
                  <a id="title-link" href="#" class="net-card-link text-muted">
                    <img src="/img/on-air-inactive2.png" id="onairimg" width="62" height="22" alt="Net status" />
                    <span id="title"></span>
                  </a>
                  <span class="text-tertiary">
                    <% if (user.isLoggedIn) { %>
                    <i class="bi bi-star favicon" aria-label="Add to favorites" role="button"></i>
                    <% } else { %>
                    <i class="d-none bi bi-star favicon" aria-hidden="true"></i>
                    <% } %>
                  </span>
                </div>
                <div class="net-card-meta">
                  <span id="startTime"></span>
                  <span id="frequency"></span>
                </div>
              </div>
            </div>
          </section>

          <section class="landing-net-panel" aria-labelledby="todays-nets-title">
            <header class="landing-net-panel-heading">
              <span class="landing-panel-icon"><i class="bi bi-calendar2-day" aria-hidden="true"></i></span>
              <h3 id="todays-nets-title">Today's Nets</h3>
            </header>
            <div class="scheduled-net-list" data-scheduled-net-list="today" aria-live="polite">
              <div class="nets-state scheduled-nets-empty" data-scheduled-net-empty>
                <i class="bi bi-calendar2-day" aria-hidden="true"></i>
                No scheduled nets to display yet.
              </div>
            </div>
          </section>

          <section class="landing-net-panel" aria-labelledby="upcoming-nets-title">
            <header class="landing-net-panel-heading">
              <span class="landing-panel-icon"><i class="bi bi-calendar2-week" aria-hidden="true"></i></span>
              <h3 id="upcoming-nets-title">Upcoming Nets</h3>
            </header>
            <div class="scheduled-net-list" data-scheduled-net-list="upcoming" aria-live="polite">
              <div class="nets-state scheduled-nets-empty" data-scheduled-net-empty>
                <i class="bi bi-calendar2-week" aria-hidden="true"></i>
                Upcoming net scheduling is coming soon.
              </div>
            </div>
          </section>
        </div>

        <!-- Inert until scheduled-net data is available. Future rendering code can clone this template. -->
        <template id="scheduled-net-card-template">
          <article class="net-card scheduled-net-card">
            <div class="scheduled-net-card-content">
              <div class="scheduled-net-card-header">
                <div class="scheduled-net-card-image-slot" data-role="image-slot" hidden></div>
                <div class="scheduled-net-card-heading">
                  <h4 class="scheduled-net-card-title">
                    <span data-role="title"></span>
                  </h4>
                  <div class="scheduled-net-card-when">
                    <time data-role="date"></time>
                    <time data-role="start-time"></time>
                  </div>
                </div>
              </div>
              <p class="scheduled-net-card-description" data-role="description" hidden></p>
              <dl class="scheduled-net-connections" data-role="connection-methods" hidden></dl>
            </div>
            <div class="scheduled-net-card-actions" data-role="follow-control" hidden></div>
          </article>
        </template>
      </div>
    </section>

  </main>

  <%- include('./partials/pageBottomFeatures') %>
  <script src="/js/byView/<%= VIEW %>/main.js" type="module"></script>
  <%- include('./partials/footer', { user: user, landing: true }) %>
</body>

</html>
