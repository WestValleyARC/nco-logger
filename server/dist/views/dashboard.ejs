<!DOCTYPE html>
<html lang="en">
<!-- hamlive-oss — MIT License. See LICENSE. -->

<head>
  <%- include('./partials/head') %>
  <%- include('./partials/pageTopFeatures') %>
  <title><%= server.appName %> <% if (server.logLevel !== "info") { %> (<%= server.logLevel %>) <% } %></title>
</head>

<body class="app-page">
  <%- include('./partials/navbar', { user: user }) %>

  <main class="app-main">
    <section class="landing-hero" aria-labelledby="landing-title">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-7 pe-lg-5">
            <div class="landing-kicker">West Valley Amateur Radio Club</div>
            <h1 class="landing-title" id="landing-title">Run the net. <span>Keep it clear.</span></h1>
            <p class="landing-copy">
              A focused workspace for amateur radio net control, check-ins, relays, and live participation.
            </p>
            <div class="landing-actions">
              <% if (user.isLoggedIn) { %>
              <a class="app-button app-button-primary" href="/views/mynets">
                <i class="bi bi-broadcast" aria-hidden="true"></i>
                Start a net
              </a>
              <% } else { %>
              <a class="app-button app-button-primary" href="/views/login">
                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                Sign in to get started
              </a>
              <% } %>
              <a class="app-button app-button-secondary" href="#live-nets">
                View live nets
                <i class="bi bi-arrow-down" aria-hidden="true"></i>
              </a>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="landing-logo-panel" aria-hidden="true">
              <img class="landing-logo" src="/img/wvarc-nco-logger-logo.svg" alt="" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="nets-section" id="live-nets" aria-labelledby="live-nets-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <div class="section-eyebrow">On the air</div>
            <h2 class="section-title" id="live-nets-title">Live nets</h2>
          </div>
          <p class="section-note">Select a net to join the live logger.</p>
        </div>

        <div class="nets-list" id="dashItemsContainer" aria-live="polite" aria-busy="true">
          <div class="nets-state" id="nets-state">
            <i class="bi bi-broadcast-pin" aria-hidden="true"></i>
            Checking for live nets…
          </div>

          <!-- Template for dynamically generated net rows. IDs are scoped to each cloned row. -->
          <div id="netTemplate" class="net-card d-none">
            <div class="net-card-main">
              <a id="title-link" href="#" class="net-card-link text-muted">
                <img src="/img/on-air-inactive2.png" id="onairimg" width="62" height="22" alt="Net status" />
                <span id="title"></span>
              </a>
              <span class="text-tertiary">
                <% if (user.isLoggedIn) { %>
                <i class="bi bi-star favicon" aria-label="Add to favorites" role="button"></i>
                <% } else { %>
                <i class="d-none bi bi-star favicon" aria-hidden="true"></i>
                <% } %>
              </span>
            </div>
            <div class="net-card-meta">
              <span id="startTime"></span>
              <span id="frequency"></span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('./partials/pageBottomFeatures') %>
  <script src="/js/byView/<%= VIEW %>/main.js" type="module"></script>
  <%- include('./partials/footer') %>
</body>

</html>
