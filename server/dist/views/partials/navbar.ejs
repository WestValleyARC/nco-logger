<!--Begin: navbar.ejs-->
<% const landingNavigation = typeof landing !== 'undefined' && landing; %>
<nav class="navbar navbar-expand-lg navbar-dark app-navbar<% if (landingNavigation) { %> landing-navbar<% } %>" aria-label="Main navigation">
  <div class="container">
    <% if (landingNavigation) { %>
    <a href="/views/dashboard" class="navbar-brand landing-navbar-brand" aria-label="NCO Logger by WVARC home">
      <img src="/img/NCO_Logger_Logo_navbar.png" class="landing-brand-logo" alt="NCO Logger by WVARC" />
    </a>
    <% } else { %>
    <a href="/views/dashboard" class="navbar-brand app-navbar-brand" aria-label="NCO Logger by WVARC home — view active nets">
      <img src="/img/NCO_Logger_Logo_navbar.png" class="app-brand-logo" alt="NCO Logger by WVARC" />
    </a>
    <% } %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navmenu" aria-controls="navmenu" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navmenu">
      <ul class="navbar-nav ms-auto" role="menubar">
        <li class="nav-item" role="none">
          <a href="<%= landingNavigation ? '#live-nets' : '/views/dashboard' %>" class="nav-link" role="menuitem" tabindex="0">
            Live Nets
          </a>
        </li>
        <% if (landingNavigation) { %>
        <li class="nav-item" role="none">
          <a href="/views/mynets" class="nav-link" role="menuitem" tabindex="0">
            Start a Net
          </a>
        </li>
        <% } else { %>
        <li class="nav-item" role="none">
          <a href="/views/mynets" class="nav-link" role="menuitem" tabindex="0">
            Start a Net
          </a>
        </li>
        <% } %>
        <% if (user.isLoggedIn && !landingNavigation) { %>
        <li class="nav-item" role="none">
          <a href="/views/favorites" class="nav-link" role="menuitem" tabindex="0">
            Favorites
          </a>
        </li>
        <% } %>
        <li class="nav-item" role="none">
          <a href="/views/guide" class="nav-link" role="menuitem" tabindex="0">
            Guide
          </a>
        </li>
        <% if (user.isLoggedIn) { %>
        <li class="nav-item" role="none">
          <a href="/views/myaccount" class="nav-link" role="menuitem" tabindex="0">
            Settings
          </a>
        </li>
        <li class="nav-item" role="none">
          <a href="/auth/logout" class="nav-link" role="menuitem" tabindex="0">
            Log out
          </a>
        </li>
        <% } else { %>
        <li class="nav-item" role="none">
          <a href="/views/login" class="nav-link" role="menuitem" tabindex="0">
            Sign in
          </a>
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
<!--End: navbar.ejs-->
