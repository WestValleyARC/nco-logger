<!--Begin: footer.ejs-->
<% const landingFooter = typeof landing !== 'undefined' && landing; %>
<footer class="app-footer landing-footer">
  <div class="container">
    <div class="landing-footer-grid">
      <div class="landing-footer-brand">
        <a href="/views/dashboard" aria-label="NCO Logger by WVARC home">
          <img src="/img/NCO_Logger_Logo.png" alt="NCO Logger by WVARC" />
        </a>
        <p>NCO Logger is a modern platform for amateur radio nets. Schedule, run, follow, check in, and participate from anywhere.</p>
      </div>
      <nav class="landing-footer-column" aria-labelledby="footer-nco-title">
        <h2 id="footer-nco-title">NCO LOGGER</h2>
        <a href="<%= landingFooter ? '#live-nets' : '/views/dashboard#live-nets' %>">Live Nets</a>
        <a href="<%= landingFooter ? '#net-schedule' : '/views/dashboard#net-schedule' %>">Schedule</a>
        <a href="/views/guide">Guide</a>
        <a href="<%= user.isLoggedIn ? '/views/mynets' : '/views/login' %>">Start a Net</a>
      </nav>
      <div class="landing-footer-column" aria-labelledby="footer-wvarc-title">
        <h2 id="footer-wvarc-title">ABOUT WVARC</h2>
        <a href="https://westvalleyarc.com/about-wvarc/">About WVARC</a>
        <a href="https://westvalleyarc.com/">Club Website</a>
        <a href="https://westvalleyarc.com/membership/">Join WVARC</a>
      </div>
      <div class="landing-footer-column landing-footer-contact" aria-labelledby="footer-contact-title">
        <h2 id="footer-contact-title">CONTACT</h2>
        <a href="/views/contact"><i class="bi bi-envelope" aria-hidden="true"></i><span>Contact NCO Logger</span></a>
      </div>
    </div>
    <div class="landing-footer-bottom">
      <small>&copy; 2026 West Valley Amateur Radio Club (WVARC). All rights reserved.</small>
      <nav aria-label="Legal">
        <a href="/views/privacypolicy">Privacy Policy</a>
        <a href="/views/termsofuse">Terms of Use</a>
        <a href="/views/cookiepolicy">Cookie Policy</a>
      </nav>
    </div>
  </div>
</footer>
<!--End: footer.ejs-->
