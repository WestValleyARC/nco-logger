<!DOCTYPE html>
<html lang="en">
<!-- hamlive-oss — MIT License. See LICENSE. -->

<head>
  <%- include('./partials/head') %>
  <%- include('./partials/pageTopFeatures') %>
  <title><%= server.appName %> - Waiting for Net <% if (server.logLevel !== "info") { %> (<%= server.logLevel %>) <% } %></title>
</head>

<body class="app-page waiting-page">
  <%- include('./partials/navbar', { user: user }) %>

  <main class="app-main waiting-main">
    <header class="settings-hero">
      <div class="container">
        <div class="landing-kicker">Net Status</div>
        <h1 class="workspace-title" id="netTitle"><%= TITLE %></h1>
        <p class="workspace-copy">This net is currently off the air.</p>
        <img class="settings-header-tower" src="/img/NCO_Logger_Logo_Tower_Only.png" alt="" aria-hidden="true" />
      </div>
    </header>

    <div class="container waiting-workspace">
      <section class="waiting-status-card" aria-labelledby="waiting-card-title">
        <div class="waiting-card-heading">
          <div>
            <span class="waiting-off-air">OFF AIR</span>
            <h2 id="waiting-card-title"><%= TITLE %></h2>
          </div>
          <span class="waiting-favorite">
            <% if (user && !PERM) { %>
            <button type="button" class="bi bi-star favicon" id="fav-<%= NPID %>" aria-label="Toggle favorite net"></button>
            <% } else { %>
            <button type="button" class="d-none bi bi-star favicon" id="fav-<%= NPID %>" aria-label="Toggle favorite net"></button>
            <% } %>
          </span>
        </div>

        <div class="waiting-connection" id="netConnection" hidden>
          <p id="netConnectionPrimary" hidden></p>
          <p id="netModeDetails" hidden></p>
        </div>

        <div class="waiting-message">
          <div class="waiting-activity" aria-hidden="true"><span></span><span></span><span></span></div>
          <div>
            <h3>Waiting for Net to Start</h3>
            <p id="scheduledStart" data-start-at="<%= SCHEDULED_START_AT || '' %>" <%= SCHEDULED_START_AT ? '' : 'hidden' %>></p>
            <p>You can leave this page open. NCO Logger will automatically open the live net when it starts.</p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <%- include('./partials/footer') %>
  <%- include('./partials/pageBottomFeatures') %>
  <script src="/js/byView/<%= VIEW %>/main.js?v=<%= server.appAssetVersion %>" type="module"></script>
</body>

</html>
