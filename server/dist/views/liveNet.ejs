<!DOCTYPE html>
<html lang="en">
<!-- hamlive-oss — MIT License. See LICENSE. -->

<head>
  <%- include('./partials/head') %>
  <%- include('./partials/pageTopFeatures') %>
  <link href="/css/nco-logger.css?v=<%= server.appAssetVersion %>" rel="stylesheet">
  <title><%= TITLE %><%if (server.logLevel !== "info") {%> (<%= server.logLevel %>) <%}%></title>
</head>

<body class="nco-logger-page">
  <main id="nco-logger-root" aria-label="WVARC NCO Logger">
    <div class="nch-page-loading" role="status">Loading NCO Logger…</div>
  </main>

  <% if (user.chat) { %>
  <div id="local-chat-container" class="nch-chat-staging" aria-label="Net chat"></div>
  <% } %>

  <%- include('./partials/pageBottomFeatures') %>
  <script src="/js/byView/<%= VIEW %>/main.js?v=<%= server.appAssetVersion %>" type="module"></script>
</body>
</html>
