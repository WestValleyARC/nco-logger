<!DOCTYPE html>
<html lang="en">
<!-- hamlive-oss — MIT License. See LICENSE. -->

<head>
  <%- include('./partials/head') %>
  <%- include('./partials/pageTopFeatures') %>
  <title><%= server.appName %> - Net Schedule <% if (server.logLevel !== "info") { %> (<%= server.logLevel %>) <% } %></title>
</head>

<body class="app-page public-directory-page schedule-page">
  <%- include('./partials/navbar', { user: user }) %>

  <main class="app-main public-directory-main">
    <header class="public-directory-hero">
      <div class="container">
        <div class="landing-kicker">Plan Ahead</div>
        <h1 class="workspace-title">Net Schedule</h1>
        <p class="workspace-copy">Browse scheduled amateur radio nets in your local timezone.</p>
        <img class="public-directory-tower" src="/img/NCO_Logger_Logo_Tower_Only.png" alt="" aria-hidden="true" />
      </div>
    </header>

    <section class="container public-directory-workspace" aria-labelledby="schedule-list-title">
      <nav class="schedule-view-tabs" aria-label="Schedule view">
        <a href="/views/schedule?view=today" data-schedule-view="today">Today</a>
        <a href="/views/schedule?view=upcoming" data-schedule-view="upcoming">7-Day</a>
      </nav>
      <div class="schedule-toolbar">
        <div>
          <div class="landing-kicker" id="schedule-eyebrow">Today's Schedule</div>
          <h2 id="schedule-list-title">Scheduled Nets</h2>
          <p id="schedule-timezone"></p>
        </div>
        <div class="schedule-period-controls" id="schedule-period-controls" hidden>
          <button type="button" data-shift="-7" aria-label="Previous 7 days"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</button>
          <button type="button" data-shift="7" aria-label="Next 7 days">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
        </div>
      </div>
      <div class="schedule-results" id="schedule-results" aria-live="polite" aria-busy="true">
        <div class="public-directory-empty" id="schedule-state">
          <i class="bi bi-calendar2-week" aria-hidden="true"></i>
          Loading scheduled nets…
        </div>
      </div>
      <template id="schedule-day-template">
        <section class="schedule-day">
          <h3 data-role="day"></h3>
          <div data-role="items"></div>
        </section>
      </template>
      <template id="schedule-item-template">
        <a class="schedule-item" href="#">
          <time data-role="time"></time>
          <span class="schedule-item-info">
            <strong data-role="title"></strong>
            <span data-role="connection"></span>
            <span data-role="description" hidden></span>
          </span>
          <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </a>
      </template>
    </section>
  </main>

  <%- include('./partials/footer') %>
  <%- include('./partials/pageBottomFeatures') %>
  <script src="/js/byView/<%= VIEW %>/main.js?v=<%= server.appAssetVersion %>" type="module"></script>
</body>

</html>
