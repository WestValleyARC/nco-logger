<!doctype html>
<html>
    <head><meta charset="utf-8"><title><%= subject %></title></head>
    <body>
        <h3><a href="<%= url %>"><%= title %></a></h3>
        <% if (startedAtString) { %><p>Net Start Time: <%= startedAtString %></p><% } %>
        <table style="border: 1px solid; border-spacing: 0">
            <caption>Station Info</caption>
            <thead><tr><th>Role</th><th>Callsign</th><th>Check-In Time</th></tr></thead>
            <tbody><% formattedAttendees.forEach(attendee => { %>
                <tr style="<%= attendee.highlight ? 'background-color: lightgray;' : '' %>">
                    <td style="padding: 3px 6px"><%= attendee.role ? `[${attendee.role}]` : '' %></td>
                    <td style="padding: 3px 6px"><strong><%= attendee.callSign %></strong><%= attendee.sigReport ? ` (${attendee.sigReport})` : '' %></td>
                    <td style="padding: 3px 6px"><em><%= attendee.checkInTime %></em></td>
                </tr>
            <% }) %></tbody>
        </table>
    </body>
</html>
