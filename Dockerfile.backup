# syntax=docker/dockerfile:1

FROM --platform=linux/amd64 node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY client ./client
COPY server ./server
COPY scripts ./scripts
RUN npm run build && npm prune --omit=dev

FROM --platform=linux/amd64 node:22-bookworm-slim AS runtime

ARG MONGODB_TOOLS_VERSION=100.18.0
ARG MONGODB_TOOLS_SHA256=c7c797bcb78099ecb0c716eabc82403bcb886578ef8bee499a5b8f1c8c52aa0e

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSLo /tmp/mongodb-tools.tgz "https://fastdl.mongodb.org/tools/db/mongodb-database-tools-debian12-x86_64-${MONGODB_TOOLS_VERSION}.tgz" \
    && echo "${MONGODB_TOOLS_SHA256}  /tmp/mongodb-tools.tgz" | sha256sum -c - \
    && tar -xzf /tmp/mongodb-tools.tgz -C /tmp \
    && cp "/tmp/mongodb-database-tools-debian12-x86_64-${MONGODB_TOOLS_VERSION}/bin/mongodump" /usr/local/bin/ \
    && cp "/tmp/mongodb-database-tools-debian12-x86_64-${MONGODB_TOOLS_VERSION}/bin/mongorestore" /usr/local/bin/ \
    && chmod 0755 /usr/local/bin/mongodump /usr/local/bin/mongorestore \
    && apt-get purge -y curl \
    && rm -rf /var/lib/apt/lists/* /tmp/mongodb-tools.tgz /tmp/mongodb-database-tools-*

ENV NODE_ENV=production \
    HAMLIVE_BACKUP_DIR=/backups

WORKDIR /app
COPY --from=build --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/server/dist ./server/dist
RUN mkdir -p /backups && chown node:node /backups

USER node
VOLUME ["/backups"]
ENTRYPOINT ["node", "/app/server/dist/bin/dbBackup.js"]
CMD ["--help"]
