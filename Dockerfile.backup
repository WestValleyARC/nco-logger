# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY client ./client
COPY server ./server
COPY scripts ./scripts
RUN npm run build && npm prune --omit=dev

FROM mongo:7@sha256:b6421fd6d1c5ded6377b397d8983e2f82e2100dc5123332dcfda2065a472be5b AS mongo-tools

FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends awscli ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    HAMLIVE_BACKUP_DIR=/backups

WORKDIR /app
COPY --from=build --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/server/dist ./server/dist
COPY --from=mongo-tools /usr/bin/mongodump /usr/bin/mongorestore /usr/local/bin/
COPY --chown=node:node scripts/docker/backup-scheduler.sh /usr/local/bin/backup-scheduler
RUN mkdir -p /backups /uploads && chown node:node /backups /uploads

USER node
VOLUME ["/backups"]
ENTRYPOINT ["node", "/app/server/dist/bin/dbBackup.js"]
CMD ["--help"]
