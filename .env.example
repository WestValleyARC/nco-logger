# hamlive-oss environment configuration
# Copy this file to .env (or run `npm run setup`) and adjust as needed.
#
# For a ZERO-ACCOUNT local test drive, the defaults below are enough:
# every external integration is optional and degrades gracefully when its
# variables are absent. See INSTALL.md for the full guide.

# ---- Core (required) ----
NODE_ENV=development
PORT=3000
# Display name shown in the UI (page titles, navbar, footer). Brand your instance
# for your club/group, e.g. APP_NAME="Springfield ARC Nets". Defaults to NCO Logger.
APP_NAME=NCO Logger
# Public base URL of this instance (used for OAuth callbacks and email links).
# Local dev serves plain HTTP on localhost (no certificate warning). If you set
# HTTPS=true to serve dev over HTTPS, change this to https://localhost:3000.
BASE_URL=http://localhost:3000
# MongoDB connection string. Matches the bundled docker-compose.yml, which runs
# a single-node replica set (required for real-time/SSE change streams).
# directConnection=true is needed to talk to a single-node replica set locally.
MONGODB_URI=mongodb://localhost:27017/hamlive?directConnection=true
# Compose uses a private authenticated MongoDB user unless this is set to a
# managed/external URI. Credentials must be URL-encoded if they contain URI
# metacharacters. Never commit a populated value.
# MONGODB_COMPOSE_URI=
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=
# 48+ random base64 characters shared only by replica-set members.
MONGO_REPLICA_KEY=
# Host directory used by the one-shot Compose backup service.
NCO_BACKUP_DIR=./backups
# Match the owner of NCO_BACKUP_DIR (the usual first Linux user is 1000:1000).
NCO_BACKUP_UID=1000
NCO_BACKUP_GID=1000
# Defaults to the documented 15-minute critical-data RPO when the scheduled
# backup Compose profile is enabled.
NCO_BACKUP_INTERVAL_SECONDS=900
NCO_BACKUP_RETENTION_DAYS=30
# Required by the production release gate unless equivalent off-host storage
# is documented. Credentials belong in the deployment environment.
NCO_BACKUP_S3_BUCKET=
NCO_BACKUP_S3_PREFIX=hamlive
# Override only when Compose should use an external/hosted production database.
# MONGODB_COMPOSE_URI=mongodb+srv://user:password@cluster.example/hamlive
# Development restores require a distinct URI; production is never reused.
# MONGODB_DEVELOPMENT_URI=mongodb://mongo:27017/hamlive-restore?replicaSet=rs0&directConnection=true
# Signing secrets. CHANGE THESE to long random values for any hosted instance.
COOKIE_SESSION_KEY=
MAGIC_LINK_SECRET=
LOG_LEVEL=debug

# ---- Deployment (optional) ----
# Serve local dev over HTTPS (self-signed cert) instead of plain HTTP. Off by
# default to avoid the browser's "not private" certificate warning on localhost.
# If you enable this, also set BASE_URL=https://localhost:3000 above.
# HTTPS=true
# Redirect HTTP->HTTPS in production when behind a TLS-terminating proxy/load
# balancer (Render, Fly, Railway, nginx, Caddy, a cloud LB, ...). Uses the
# standard x-forwarded-proto header, so it is platform-neutral. Leave unset for
# local dev or if TLS is handled in front of the app.
# FORCE_HTTPS=true
# Explicitly identify the reverse proxy or hop count; forwarded headers are
# ignored unless this is set. Examples: loopback, 1, 10.0.0.0/8.
# TRUST_PROXY=loopback
# APP_BIND_IP remains 127.0.0.1 unless a deliberate network design requires
# another interface. Do not expose the Node port directly to the Internet.
# APP_BIND_IP=127.0.0.1
# APP_HOST_PORT=3000
# Compose defaults to the pre-created reverse-proxy network below. CI and
# isolated recovery drills may set a unique name and mark it non-external.
# FRONTEND_NETWORK_NAME=westvalleyarc_frontend
# FRONTEND_NETWORK_EXTERNAL=true
# Set true only after organization-approved privacy, cookie, and terms text has
# replaced/reviewed the included templates. Production fails closed otherwise.
LEGAL_CONTENT_APPROVED=false
# If your proxy drops idle connections sooner/later than ~55s, tune the SSE
# keep-alive push interval ceiling (milliseconds).
# SSE_IDLE_TIMEOUT_MS=55000
# Continuous absence of an active NCO or present profile owner/co-owner before
# a non-permanent live net is automatically closed (default: 30 minutes).
NCO_ABANDONMENT_MINUTES=30

# ---- Email / login delivery (optional) ----
# Without SMTP, the local login page displays the magic sign-in link in
# development only. Tokens are not logged. Production never exposes a magic
# link when mail is disabled.
MAIL_TRANSPORT=console
# SMTP_HOST=smtp-relay.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=NCO Logger <logger@westvalleyarc.com>
# EMAIL_REPLY_TO=logger@westvalleyarc.com

# ---- Google OAuth (optional) ----
# Without these, the login page shows email magic-link sign-in only.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BASE_URL>/auth/google/redirect
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Local chat ----
# Chat uses MongoDB, cookie authentication, SSE, and local image storage.
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_RATE_LIMIT_COUNT=12
CHAT_RATE_LIMIT_WINDOW_MS=10000
# PNG, JPEG, GIF, and WebP uploads are accepted. The server caps this value at 10 MB.
CHAT_UPLOAD_DIR=/app/data/chat-uploads
CHAT_MAX_UPLOAD_MB=5

# ---- QRZ.com callsign lookup (optional) ----
# Without these, callsign profile enrichment is skipped.
# Requires a QRZ XML subscription: https://www.qrz.com/page/xml_data.html
# QRZ_USERNAME=
# QRZ_PASSWORD=
# Refresh cached callsign data after this many hours (default: 168 / seven days).
QRZ_CACHE_TTL_HOURS=168

# ---- Reverse geocoding (optional, Azure Maps by default) ----
# Without GEO_KEY, member location resolution is skipped.
# GEO_KEY=

# ---- Misc (optional) ----
# Override the net-control command help link shown in the UI.
# CMD_HELP_URL=
